// ======================================================
// 03_pares_impares.mil - Clasificador de Pares e Impares
// Pide 8 numeros enteros, cuenta cuantos son pares y
// cuantos impares, y suma solo los pares.
// Un numero es par si su residuo entre 2 es 0 (n % 2).
// Moises Moncada - Proyecto Final - Compiladores
// ======================================================

var:int[] numeros = [];
var:int n = 0;

print("=== CLASIFICADOR DE PARES E IMPARES ===");

// 1. Llenar el arreglo con 8 numeros
for i = 1 to 8 : {
    read("Numero " + i + " de 8: ", n);
    numeros.push(n);
}

// 2. Recorrer el arreglo y clasificar
var:int pares = 0;
var:int impares = 0;
var:int suma_pares = 0;
for i = 0 to numeros.length() - 1 : {
    if numeros[i] % 2 is 0 : {
        pares = pares + 1;
        suma_pares = suma_pares + numeros[i];
    } else {
        impares = impares + 1;
    }
}

print("");
print("Numeros: ", numeros);
print("Cantidad de pares: ", pares);
print("Cantidad de impares: ", impares);
print("Suma de los pares: ", suma_pares);
